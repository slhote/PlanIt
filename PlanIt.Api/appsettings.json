{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "[replaced by env var in deployed]"
  },
  "Cors": {
    "AllowedOrigins": ["https://slhote.github.io"]
  },
  "Jwt": {
    "Issuer": "PlanIt",
    "Audience": "PlanIt",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SigningKey": ""
  },
  "SimilarWorkItems": {
    "LexicalStrategy": "Jaccard",
    "MaxResults": 5,
    "MinScoreThreshold": 0.3,
    "Weights": {
      "TagOverlap": 0.35,
      "AssigneeMatch": 0.15,
      "LexicalText": 0.5
    }
  },
  "AllowedHosts": "*"
}
