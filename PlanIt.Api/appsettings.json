{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "[replaced by env var in deployed]"
  },
  "Cors": {
    "AllowedOrigins": ["https://slhote.github.io"]
  },
  "Jwt": {
    "Issuer": "PlanIt",
    "Audience": "PlanIt",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SigningKey": ""
  },
  "SimilarWorkItems": {
    "LexicalStrategy": "Jaccard",
    "MaxResults": 5,
    "MinScoreThreshold": 0.3,
    "EmbeddingSource": "Onnx",
    "Weights": {
      "TagOverlap": 0.2,
      "AssigneeMatch": 0.1,
      "LexicalText": 0.3,
      "Embedding": 0.4
    }
  },
  "OnnxEmbedding": {
    "ModelPath": "Models/all-MiniLM-L6-v2/model.onnx",
    "VocabPath": "Models/all-MiniLM-L6-v2/vocab.txt",
    "MaxTokens": 256
  },
  "PythonEmbedding": {
    "BaseUrl": "http://localhost:8000",
    "RetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 250
  },
  "EmbeddingWorker": {
    "SweepIntervalMinutes": 5
  },
  "AllowedHosts": "*"
}
